# Update Sysmon configuration
update-sysmon:
    #!{{shebang}}
    Write-Host '===== Updating Sysmon Configuration =====' -ForegroundColor Cyan
    $env:KK_BASE_DIR = '{{base_dir}}'
    $env:KK_TOOLS_DIR = '{{tools_dir}}/sysinternals'
    & {{scripts_dir}}/Install-Sysmon.ps1 -Update

# Check Sysmon installation status
check-sysmon:
    #!{{shebang}}
    Write-Host '===== Sysmon Status Check =====' -ForegroundColor Cyan
    $env:KK_BASE_DIR = '{{base_dir}}'
    $env:KK_TOOLS_DIR = '{{tools_dir}}/sysinternals'
    & {{scripts_dir}}/Install-Sysmon.ps1 -Verify

# Query recent Sysmon events
query-sysmon hours="1":
    #!{{shebang}}
    Write-Host '===== Querying Sysmon Events =====' -ForegroundColor Cyan
    & {{scripts_dir}}/Invoke-SysmonMonitor.ps1 -Query recent -Hours {{hours}}

